# =============================================================================
# SONEF ADMIN DASHBOARD — PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file to .env.local on the production server and fill every value.
# NEVER commit a filled .env.local to git.
#
# HOW TO RUN IN PRODUCTION
# ────────────────────────
# Option A – Vercel / Netlify / cloud hosting
#   Set these vars in the hosting dashboard's environment settings panel.
#   Re-deploy after saving.
#
# Option B – Self-hosted (PM2 / Docker)
#   cp .env.production .env.local
#   # fill all values below
#   npm ci
#   npm run build         # produces the .next/ output
#   npm run start         # starts the Next.js production server on PORT
#
# Option C – Docker Compose
#   Pass these as environment vars in docker-compose.prod.yml
#   (they are already referenced in the top-level docker-compose.prod.yml)
# =============================================================================

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the deployed NestJS backend (no trailing slash)
NEXT_PUBLIC_API_URL=https://sonef-backend.onrender.com

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
